# Copiez ce fichier en config.env et remplissez-le.

# --- E-mail (SMTP) ---
MAIL_TO=vous@exemple.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.compte@gmail.com
# Pour Gmail : un « mot de passe d'application », pas votre mot de passe normal.
SMTP_PASSWORD=
# MAIL_FROM=  (par défaut : SMTP_USER)

# --- ntfy (facultatif, peut être utilisé en plus de l'e-mail) ---
# NTFY_TOPIC=zelda-fnac-8a710a7c
